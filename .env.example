# ProdPulse Assembly TV Dashboard — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local` (git-ignored).
#
# Public Firebase Web SDK config of the EXISTING ProdPulse project
# (technico-industries-ltd) — the same values as the ProdPulse app's
# src/services/firebase.ts. These identify the project; they are not secrets.
# Everything prefixed VITE_ is bundled into the browser, so NEVER put Gemini
# keys, Admin SDK / service-account credentials or private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=technico-industries-ltd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=technico-industries-ltd
VITE_FIREBASE_STORAGE_BUCKET=technico-industries-ltd.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=281455614052
VITE_FIREBASE_APP_ID=1:281455614052:web:c3396380547310fa686771

# live (default): realtime listeners on the tvDashboard/** aggregate documents
#                 written by the ProdPulse Cloud Functions — nothing else is read.
# demo:           built-in DEMONSTRATION data, no Firebase connection. Never used
#                 as a fallback for missing live data.
VITE_DASHBOARD_MODE=live

# Seconds each page of the line-status grid is shown before rotating.
VITE_LINE_PAGE_SECONDS=15
